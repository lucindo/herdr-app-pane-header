#!/usr/bin/env bash
# Lint and test everything. The pre-commit hook calls this.
set -euo pipefail
cd "$(dirname "$0")/.."

for mod in mods/*/; do
  [ -e "$mod" ] || continue
  echo "check: ${mod%/}"
  # Also writes the mod's gpui-kit.d.ts, which tsc needs.
  herdr-app check "$mod"
  node_modules/.bin/tsc -p "${mod}jsconfig.json"
done

# A git hook inherits these (`commit -a` sets GIT_INDEX_FILE).
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE
node --test
